{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Starter three-tier design tokens: Tier 1 OpenDesign contract (Apple macOS/HIG-inspired light and dark OKLCH neutral and semantic palette), Tier 2 semantic extensions, Tier 3 component-scoped tokens (internal dense defaults + public touch overrides).",
  "contract": {
    "color": {
      "light": {
        "bg": { "$type": "color", "$value": "oklch(0.99 0.002 260)" },
        "surface": { "$type": "color", "$value": "oklch(1 0 0)" },
        "surface-warm": { "$type": "color", "$value": "oklch(0.97 0.006 85)" },
        "fg": { "$type": "color", "$value": "oklch(0.18 0.008 260)" },
        "fg-2": { "$type": "color", "$value": "oklch(0.36 0.008 260)" },
        "muted": { "$type": "color", "$value": "oklch(0.49 0.008 260)" },
        "meta": { "$type": "color", "$value": "oklch(0.60 0.006 260)" },
        "border": { "$type": "color", "$value": "oklch(0.88 0.005 260)" },
        "border-soft": { "$type": "color", "$value": "oklch(0.93 0.004 260)" },
        "accent": { "$type": "color", "$value": "oklch(0.52 0.16 255)" },
        "accent-on": { "$type": "color", "$value": "oklch(0.99 0 0)" },
        "accent-hover": { "$type": "color", "$value": "oklch(0.47 0.16 255)" },
        "accent-active": { "$type": "color", "$value": "oklch(0.42 0.16 255)" },
        "success": { "$type": "color", "$value": "oklch(0.52 0.14 150)" },
        "warn": { "$type": "color", "$value": "oklch(0.62 0.15 70)" },
        "danger": { "$type": "color", "$value": "oklch(0.54 0.19 25)" }
      },
      "dark": {
        "bg": { "$type": "color", "$value": "oklch(0.15 0.006 260)" },
        "surface": { "$type": "color", "$value": "oklch(0.19 0.006 260)" },
        "surface-warm": { "$type": "color", "$value": "oklch(0.22 0.008 85)" },
        "fg": { "$type": "color", "$value": "oklch(0.94 0.004 260)" },
        "fg-2": { "$type": "color", "$value": "oklch(0.79 0.006 260)" },
        "muted": { "$type": "color", "$value": "oklch(0.67 0.006 260)" },
        "meta": { "$type": "color", "$value": "oklch(0.54 0.006 260)" },
        "border": { "$type": "color", "$value": "oklch(0.30 0.006 260)" },
        "border-soft": { "$type": "color", "$value": "oklch(0.24 0.006 260)" },
        "accent": { "$type": "color", "$value": "oklch(0.66 0.15 255)" },
        "accent-on": { "$type": "color", "$value": "oklch(0.14 0.006 260)" },
        "accent-hover": { "$type": "color", "$value": "oklch(0.71 0.15 255)" },
        "accent-active": { "$type": "color", "$value": "oklch(0.75 0.14 255)" },
        "success": { "$type": "color", "$value": "oklch(0.68 0.14 150)" },
        "warn": { "$type": "color", "$value": "oklch(0.76 0.14 75)" },
        "danger": { "$type": "color", "$value": "oklch(0.66 0.18 25)" }
      }
    },
    "font": {
      "display": { "$type": "fontFamily", "$value": ["system-ui", "-apple-system", "sans-serif"] },
      "body": { "$type": "fontFamily", "$value": ["system-ui", "-apple-system", "sans-serif"] },
      "mono": { "$type": "fontFamily", "$value": ["ui-monospace", "SFMono-Regular", "monospace"] }
    },
    "text": {
      "xs": { "$type": "dimension", "$value": "12px" },
      "sm": { "$type": "dimension", "$value": "13px" },
      "base": { "$type": "dimension", "$value": "14px" },
      "md": { "$type": "dimension", "$value": "16px" },
      "lg": { "$type": "dimension", "$value": "18px" },
      "xl": { "$type": "dimension", "$value": "20px" },
      "2xl": { "$type": "dimension", "$value": "24px" },
      "3xl": { "$type": "dimension", "$value": "32px" },
      "4xl": { "$type": "dimension", "$value": "44px" }
    },
    "leading": {
      "tight": { "$type": "number", "$value": 1.2 },
      "body": { "$type": "number", "$value": 1.5 }
    },
    "tracking": {
      "display": { "$type": "dimension", "$value": "-0.02em" }
    },
    "space": {
      "1": { "$type": "dimension", "$value": "4px" },
      "2": { "$type": "dimension", "$value": "8px" },
      "3": { "$type": "dimension", "$value": "12px" },
      "4": { "$type": "dimension", "$value": "16px" },
      "5": { "$type": "dimension", "$value": "20px" },
      "6": { "$type": "dimension", "$value": "24px" },
      "8": { "$type": "dimension", "$value": "32px" },
      "10": { "$type": "dimension", "$value": "40px" },
      "12": { "$type": "dimension", "$value": "48px" }
    },
    "section-y": {
      "sm": { "$type": "dimension", "$value": "48px" },
      "md": { "$type": "dimension", "$value": "72px" },
      "lg": { "$type": "dimension", "$value": "104px" }
    },
    "radius": {
      "sm": { "$type": "dimension", "$value": "4px" },
      "md": { "$type": "dimension", "$value": "6px" },
      "lg": { "$type": "dimension", "$value": "10px" },
      "pill": { "$type": "dimension", "$value": "9999px" }
    },
    "elev": {
      "flat": { "$type": "shadow", "$value": "none" },
      "ring": { "$type": "shadow", "$value": "0 0 0 1px var(--border)" },
      "raised": { "$type": "shadow", "$value": "0 8px 24px -4px oklch(0.15 0.01 260 / 0.16), 0 0 0 1px var(--border)" }
    },
    "focus-ring": {
      "$type": "shadow",
      "$value": "0 0 0 2px var(--bg), 0 0 0 4px var(--accent)"
    },
    "motion": {
      "fast": { "$type": "duration", "$value": "120ms" },
      "base": { "$type": "duration", "$value": "200ms" },
      "ease-standard": { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1] }
    },
    "layout": {
      "container-max": { "$type": "dimension", "$value": "1200px" },
      "container-gutter-sm": { "$type": "dimension", "$value": "16px" },
      "container-gutter-lg": { "$type": "dimension", "$value": "32px" }
    }
  },
  "extensions": {
    "panel": { "$type": "color", "$value": "color-mix(in oklab, var(--bg) 94%, var(--fg) 6%)" },
    "surface-hover": { "$type": "color", "$value": "color-mix(in oklab, var(--fg) 5%, transparent)" },
    "surface-selected": { "$type": "color", "$value": "color-mix(in oklab, var(--accent) 12%, transparent)" },
    "overlay": { "$type": "color", "$value": "oklch(0.12 0.006 260 / 0.45)" },
    "accent-soft": { "$type": "color", "$value": "color-mix(in oklab, var(--accent) 12%, transparent)" },
    "success-soft": { "$type": "color", "$value": "color-mix(in oklab, var(--success) 12%, transparent)" },
    "warn-soft": { "$type": "color", "$value": "color-mix(in oklab, var(--warn) 14%, transparent)" },
    "danger-soft": { "$type": "color", "$value": "color-mix(in oklab, var(--danger) 12%, transparent)" }
  },
  "components": {
    "button": {
      "height-sm": { "$type": "dimension", "$value": "28px" },
      "height-md": { "$type": "dimension", "$value": "32px" },
      "height-lg": { "$type": "dimension", "$value": "36px" },
      "px-sm": { "$type": "dimension", "$value": "{contract.space.2}" },
      "px-md": { "$type": "dimension", "$value": "{contract.space.3}" },
      "px-lg": { "$type": "dimension", "$value": "{contract.space.4}" },
      "radius": { "$type": "dimension", "$value": "{contract.radius.md}" },
      "primary-bg": { "$type": "color", "$value": "var(--accent)" },
      "primary-fg": { "$type": "color", "$value": "var(--accent-on)" },
      "secondary-bg": { "$type": "color", "$value": "var(--surface-hover)" },
      "secondary-fg": { "$type": "color", "$value": "var(--fg)" },
      "danger-bg": { "$type": "color", "$value": "var(--danger)" },
      "danger-fg": { "$type": "color", "$value": "var(--accent-on)" }
    },
    "input": {
      "height": { "$type": "dimension", "$value": "32px" },
      "px": { "$type": "dimension", "$value": "{contract.space.3}" },
      "bg": { "$type": "color", "$value": "var(--surface)" },
      "border": { "$type": "color", "$value": "var(--border)" },
      "radius": { "$type": "dimension", "$value": "{contract.radius.sm}" }
    },
    "track": {
      "bg": { "$type": "color", "$value": "var(--surface-hover)" },
      "thumb-bg": { "$type": "color", "$value": "var(--surface)" },
      "radius": { "$type": "dimension", "$value": "{contract.radius.md}" }
    },
    "badge": {
      "height": { "$type": "dimension", "$value": "20px" },
      "px": { "$type": "dimension", "$value": "{contract.space.2}" },
      "radius": { "$type": "dimension", "$value": "{contract.radius.pill}" }
    },
    "row": {
      "height": { "$type": "dimension", "$value": "36px" },
      "px": { "$type": "dimension", "$value": "{contract.space.3}" },
      "border": { "$type": "color", "$value": "var(--border-soft)" }
    },
    "tile": {
      "bg": { "$type": "color", "$value": "var(--surface)" },
      "radius": { "$type": "dimension", "$value": "{contract.radius.lg}" }
    },
    "dialog": {
      "bg": { "$type": "color", "$value": "var(--surface)" },
      "radius": { "$type": "dimension", "$value": "{contract.radius.lg}" },
      "shadow": { "$type": "shadow", "$value": "{contract.elev.raised}" },
      "max-w": { "$type": "dimension", "$value": "560px" },
      "confirm-w": { "$type": "dimension", "$value": "400px" }
    },
    "nav": {
      "sidebar-width": { "$type": "dimension", "$value": "240px" },
      "header-height": { "$type": "dimension", "$value": "48px" },
      "item-height": { "$type": "dimension", "$value": "32px" },
      "item-radius": { "$type": "dimension", "$value": "{contract.radius.md}" }
    },
    "public-overrides": {
      "$description": "Density overrides for public sites and touch-first storefronts (44 px minimum touch target).",
      "button": {
        "height-sm": { "$type": "dimension", "$value": "36px" },
        "height-md": { "$type": "dimension", "$value": "44px" },
        "height-lg": { "$type": "dimension", "$value": "48px" }
      },
      "input": {
        "height": { "$type": "dimension", "$value": "44px" }
      },
      "badge": {
        "height": { "$type": "dimension", "$value": "24px" }
      },
      "row": {
        "height": { "$type": "dimension", "$value": "44px" },
        "px": { "$type": "dimension", "$value": "{contract.space.4}" }
      },
      "nav": {
        "header-height": { "$type": "dimension", "$value": "64px" },
        "item-height": { "$type": "dimension", "$value": "44px" }
      }
    }
  }
}
